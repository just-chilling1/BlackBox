NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App domain — where this software is hosted (auth redirects, password-reset emails).
# Local: http://localhost:3000  |  Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Software name — shown in auth UI, onboarding, training copy, browser title.
# Change to your product name (e.g. My SaaS App). Also update brand.config.ts colors/logo.
NEXT_PUBLIC_PRODUCT_NAME=BlackBox Cash

# Local preview only — skip login + onboarding redirects
# DEV_BYPASS_AUTH=true

# Optional: signup webhook (Make.com, etc.)
WEBHOOK_SIGNUP_URL=

# Support API (Freshdesk + Resend fallback) — used by /api/support
# FRESHDESK_DOMAIN=yourdomain
# FRESHDESK_API_KEY=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Your App <support@yourdomain.com>

# Feature module env (only when core-workflow is enabled)
# RAPIDAPI_KEY=
# RAPIDAPI_HOST_REDDIT=
# RAPIDAPI_HOST_YOUTUBE=
# RAPIDAPI_HOST_CHATGPT=
# SCRAPERAPI_KEY=
# PROJECT_REF=

# Supabase auth setup script
# SUPABASE_ACCESS_TOKEN=

# --- blog-builder (generation pipeline) ---
# Required for scrape cache, click tracking, dev bypass
# SUPABASE_SERVICE_ROLE_KEY=

# AI text generation (RapidAPI GPT — same provider as clickcloneprofits)
# RAPIDAPI_KEY=e58a784d0dmsh8c00f2f58365008p103943jsn729926f8c316
# RAPIDAPI_HOST=chatgpt-42.p.rapidapi.com

# Image generation fallback chain
